# ==================== BANCO DE DADOS (AIVEN) ====================
DB_HOST=seu-host-do-aiven.aivencloud.com
DB_PORT=3306
DB_NAME=meu_controle_financeiro_web
DB_USER=seu_usuario_dev
DB_PASSWORD=sua_senha

# TLS obrigatório para Aiven e produção. No Render, cadastrar o CA como Secret File.
DB_SSL=true
# Opcional: quando vazio, usa backend/certs/ca.pem.
DB_CA_PATH=

# Obrigatório: gerar um segredo aleatório de pelo menos 32 bytes. Não usar este arquivo como segredo.
JWT_SECRET=

PORT=3000
NODE_ENV=development
