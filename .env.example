# PostgreSQL / Supabase Session Pooler. Preencha somente no .env local.
DB_HOST=seu-host-session-pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.seu_project_ref
DB_PASSWORD=
# Opcional: certificado CA do Supabase; nunca use o certificado antigo da Aiven.
# Vazio: utiliza as autoridades confiáveis padrão do Node.js.
DB_SSL_CA_PATH=
PORT=3000
NODE_ENV=development
JWT_SECRET=
# Homologação apenas. NODE_ENV=production bloqueia a recuperação mesmo com true.
RECOVERY_ENABLED=false
# IPs/CIDRs dos proxies confiáveis, separados por vírgula. Vazio: ignora X-Forwarded-For.
# Preencher somente após confirmar a cadeia de proxy e a origem de conexão no Render.
TRUSTED_PROXY_CIDRS=
