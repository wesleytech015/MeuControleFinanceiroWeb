# PostgreSQL / Supabase Session Pooler. Preencha somente no .env local.
DB_HOST=seu-host-session-pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.seu_project_ref
DB_PASSWORD=
# Opcional: certificado CA do Supabase; nunca use o certificado antigo da Aiven.
# Vazio: utiliza as autoridades confiáveis padrão do Node.js.
DB_SSL_CA_PATH=
# Na Vercel, conteúdo do CA Supabase como alternativa ao arquivo; aceita \n literais.
DB_SSL_CA_PEM=
# TLS obrigatório para Supabase e produção. false somente em PostgreSQL local isolado.
DB_SSL=true
PORT=3000
NODE_ENV=development
JWT_SECRET=

# Piloto opt-in. Manter false até configurar Meta e aplicar a migração SQL.
WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Copiar a versão Graph disponível no painel Meta; não é a versão do aplicativo.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TIMEZONE=America/Sao_Paulo
# Homologação apenas. NODE_ENV=production bloqueia a recuperação mesmo com true.
RECOVERY_ENABLED=false
# IPs/CIDRs dos proxies confiáveis, separados por vírgula. Vazio: ignora X-Forwarded-For.
# Preencher somente após confirmar a cadeia de proxy e a origem de conexão no Render.
TRUSTED_PROXY_CIDRS=

# IA opt-in: chave exclusivamente no servidor. Selecione modelo Flash disponível no AI Studio.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

# Qwen: confirmar Free Quota Only no painel de Singapura antes de habilitar.
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_MODEL=
QWEN_WORKSPACE_ID=
